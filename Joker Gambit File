      <button id="btnDefend" disabled>🛡️ Defend</button>
      <button id="btnAdvance" disabled>⬆️ Advance</button>
      <button id="btnAbility" disabled>⚡ Ability</button>
    </div>
    <div class="action-btns">
      <button id="btnEndPhase" class="primary">⚔️ Battle / End Turn</button>
    </div>
  </div>
  <div class="hand" id="playerHand"></div>
</footer>

